# ============================================
# FLASHLOAN ARBITRAGE BOT - CONFIGURATION
# ============================================
# Rename this file to .env and fill in your values

# ============================================
# ALCHEMY API (Required - Get free at alchemy.com)
# ============================================
ALCHEMY_API_KEY=Ivn7xi6GMvdjeQnCEz5Jh

# ============================================
# NETWORK SELECTION
# Options: polygon (recommended), arbitrum, optimism
# Start with polygon for lowest gas costs
# ============================================
NETWORK=polygon

# ============================================
# TRADING PARAMETERS
# ============================================
# Minimum profit in USD before executing a trade
MIN_PROFIT_USD=0.50

# Maximum gas price to pay (in gwei)
MAX_GAS_PRICE_GWEI=100

# Slippage tolerance percentage
SLIPPAGE_TOLERANCE=0.5

# ============================================
# WALLET (Only add when ready for real trades)
# ============================================
# Your private key - NEVER share this!
# Leave empty for simulation mode
PRIVATE_KEY=

# ============================================
# GASLESS OPTIONS (Optional)
# ============================================
# Gelato API key for gasless transactions
GELATO_API_KEY=

# Biconomy API key (alternative gasless option)
BICONOMY_API_KEY=

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info


